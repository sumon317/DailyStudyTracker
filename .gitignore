# Dependencies
node_modules/
.bun/

# Build outputs
dist/
build/
coverage/
/release/

# Capacitor Android build artifacts
android/app/build/
android/.gradle/
android/build/
android/capacitor-cordova-android-plugins/build/
android/.idea/
*.apk
*.aab

# Local environment files
# Every .env* form is ignored, not just the `.local` suffixed ones, so a
# `.env.production` holding a secret cannot be committed by accident. No
# VITE_* value belongs in this repository at all: Vite inlines them into the
# browser bundle.
.env
.env.*
android/local.properties

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
# Eclipse/JDT per-module settings. The Gradle build regenerates what it needs,
# and these files record one developer's IDE choices rather than the project.
android/app/.settings/

# Editor and agent tooling state. These directories hold session state,
# hook baselines and scan reports: they are regenerated on every run, are
# specific to one machine, and have no business in the repository.
.mimosa/
.zcode/
.opencode/.cache/

# OS generated files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# Debug and log files
bun-debug.log*
bun-error.log*
*.log

# Temporary files
.cache/
*.tsbuildinfo

# Security and release keys
*.jks
*.keystore
key_base64.txt

# Android lint output
android/app/reports/
android/app/lint-results*.txt
android/app/lint-results*.html
android/app/lint-results*.xml
