{
  "name": "daily-study-tracker",
  "private": true,
  "version": "2.2.3",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "config:check": "bun scripts/config-check.ts",
    "assets:check": "bun scripts/assets-check.ts",
    "pwa:check": "bun scripts/pwa-check.ts",
    "license:check": "bun scripts/license-check.ts",
    "android:sync": "bun run build && cap sync android",
    "android:open": "cap open android",
    "verify": "bun run config:check && bun run assets:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run pwa:check"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^13.4.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@capacitor/cli": "^8.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "5.0.5",
    "autoprefixer": "^10.6.1",
    "jsdom": "29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.5"
  }
}
