# The Gradle launcher has no extension, so `* text=auto` alone would let a
# Windows checkout with core.autocrlf=true hand a CRLF script to sh, which then
# fails with `$'\r': command not found`. Pin both wrappers explicitly.
gradlew text eol=lf
gradlew.bat text eol=crlf
LICENSE text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

