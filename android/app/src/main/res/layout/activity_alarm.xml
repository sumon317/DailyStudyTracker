<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_timer_icon"
        android:layout_marginBottom="32dp"
        android:tint="#8B5CF6"/> <!-- Tailwind Violet-500 equivalent -->

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time's Up!"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your scheduled time has finished."
        android:textSize="18sp"
        android:textColor="#A0A0A0"
        android:gravity="center"
        android:layout_marginBottom="64dp"/>

    <Button
        android:id="@+id/btn_stop_alarm"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="STOP ALARM"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#EF4444" /> <!-- Tailwind Red-500 equivalent -->

</LinearLayout>
